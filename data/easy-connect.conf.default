# Factory defaults; saved easy-connect.conf takes precedence.
# Set separate SSH and FTP passwords on the device before starting services.
auth=password
ftp_auth=password
bind_address=0.0.0.0
ssh_port=2222
ftp_port=2121
pasv_min=50000
pasv_max=50009
ftp_user=current
ftp_root=/mnt/ext1
# State and daemon configurations are created by the application.
