set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR armv7)
if(NOT DEFINED ENV{POCKETBOOK_SDK})
  message(FATAL_ERROR "Set POCKETBOOK_SDK to SDK-B288-6.10")
endif()
file(TO_CMAKE_PATH "$ENV{POCKETBOOK_SDK}" PB_SDK)
set(CMAKE_SYSROOT "${PB_SDK}/usr/arm-obreey-linux-gnueabi/sysroot")
set(CMAKE_C_COMPILER "${PB_SDK}/usr/bin/arm-obreey-linux-gnueabi-gcc")
set(CMAKE_STRIP "${PB_SDK}/usr/bin/arm-obreey-linux-gnueabi-strip")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=softfp -DPLATFORM_FC")
